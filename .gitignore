# Local run evidence generated by dry-runs/path tests.
# Historical tracked evidence remains tracked; force-add intentional new evidence.
internal/build/.sdp/evidence/*/
!internal/build/.sdp/evidence/f147/

# SDP harness config (F128: sdp/ submodule retired, F128-06: tracked symlinks → prompts/)
# Tracked symlinks: .claude/agents → ../prompts/agents, .claude/skills → ../.agents/skills
# /sdp/ is a local live clone of github.com/fall-out-bug/sdp for scripts/sdp-publish.sh (F128-07)
# Anchored with leading slash so it does NOT match cmd/sdp/ — that match silently
# ignored new files in cmd/sdp/ (e.g. cmd_manifest.go added in F141-01).
/sdp/
.claude/worktrees/
.cursor/skills
.cursor/agents
.opencode/skills
.prompts
evaluator-orchestrator
sdp-ready

.cache/
.sisyphus/
/sdp-gh-findings-sync
sdp-up

# Dolt database files (added by bd init)
.dolt/
*.db
sdp-dispatch

# Env files (secrets)
.env
.env.*

# Cursor hooks state
.cursor/hooks/

# Stale git artifacts
ORIG_HEAD

# Additional build artifacts
sdp_bin
sdp-beads-bridge

# sdp/ — optional local checkout of public sdp repo (https://github.com/fall-out-bug/sdp)
