.sdp/*
!.sdp/config.yml
!.sdp/pipeline-hooks.yaml.example
!.sdp/policies/
!.sdp/agent-constraints.yaml

# opencode-mem storage
.sdp/mem/

# session-only wisps (ephemeral work items)
.sdp/session/
__pycache__/
*.pyc
.tmp/
.kube/

# Coverage files
*.out

# Go binaries (built locally, root only)
/adapter-controller
/autonomy-worker
/feature-orchestrator
/intake-gateway
/orchestrator
/pr-publish
/registry-agent
/swarm-orchestrator
/swarm-worker
/telemetry-analyzer
/sdp-evidence
/sdp-ci-loop
/sdp-orchestrate
/sdp-eval
/sdp-guard
/beads-fsm
/brain-gateway
/cicd-agent

# Build output (make build-sdp-*)
bin/

# Execution state
.oneshot/

# SDP (sdp is submodule; skills/agents are symlinks)
.claude/skills
.claude/agents
.cursor/skills
.cursor/agents
.opencode/skills
.prompts
evaluator-orchestrator
sdp-ready

.cache/
.sisyphus/
sdp-gh-findings-sync
sdp-up

# Dolt database files (added by bd init)
.dolt/
*.db
sdp-dispatch

# Env files (secrets)
.env
.env.*

# Cursor hooks state
.cursor/hooks/

# Stale git artifacts
ORIG_HEAD

# Additional build artifacts
sdp_bin
sdp-beads-bridge

# Main CLI binary (rebuilt from source)
/sdp
