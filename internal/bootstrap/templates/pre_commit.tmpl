#!/bin/bash
# Generated by sdp bootstrap

# Check for DRAFT files (fail fast, before other checks)
draft_files=$(git diff --cached --name-only | grep '^DRAFT-')
if [ -n "$draft_files" ]; then
  echo "ERROR: DRAFT files detected. Rename (remove DRAFT- prefix) before committing. Files:"
  echo "$draft_files"
  exit 1
fi

# Run linter on staged files
{{.LintCommand}} || exit 1

# Check for sensitive files (NUL-safe to handle filenames with spaces)
git diff --cached --name-only -z | while IFS= read -r -d '' f; do
  case "$f" in
    .env*|*.pem|*.key|credentials.*|secrets.*)
      echo "ERROR: Sensitive file staged: $f"
      exit 1
      ;;
  esac
done
# Propagate exit from subshell if a sensitive file was found
if [ "$?" -ne 0 ]; then
  exit 1
fi
