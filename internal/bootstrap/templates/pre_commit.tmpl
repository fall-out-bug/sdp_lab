#!/bin/bash
# Generated by sdp bootstrap

# Run linter on staged files
{{.LintCommand}} || exit 1

# Check for sensitive files (NUL-safe to handle filenames with spaces)
git diff --cached --name-only -z | while IFS= read -r -d '' f; do
  case "$f" in
    .env*|*.pem|*.key|credentials.*|secrets.*)
      echo "ERROR: Sensitive file staged: $f"
      exit 1
      ;;
  esac
done
# Propagate exit from subshell if a sensitive file was found
if [ "$?" -ne 0 ]; then
  exit 1
fi
