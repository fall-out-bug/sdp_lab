{
  "$schema": "https://raw.githubusercontent.com/badlogic/pi-mono/main/packages/coding-agent/docs/settings-schema.json",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-sonnet-4-20250514",
  "defaultThinkingLevel": "medium",
  "theme": "sdp-dark",
  "quietStartup": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 24000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "enableSkillCommands": true,
  "skills": [
    "../prompts/skills",
    "./skills"
  ],
  "prompts": [
    "./prompts"
  ],
  "extensions": [
    "./extensions/sdp.ts",
    "./extensions/multilang-test.ts",
    "./extensions/test-picker.ts",
    "./extensions/subagent-dispatch.ts"
  ],
  "warnings": {
    "anthropicExtraUsage": true
  }
}
