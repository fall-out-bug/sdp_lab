{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdp/specs/runtime/schemas/feature-task-contract.schema.json",
  "title": "Feature Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "created_at",
    "objective",
    "acceptance_criteria",
    "required_metrics",
    "required_evidence",
    "quality_gates",
    "constraints"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "priority"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          }
        }
      }
    },
    "required_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "target", "direction"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": ["number", "string"]
          },
          "direction": {
            "type": "string",
            "enum": ["at_least", "at_most", "equals"]
          }
        }
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "test_results",
          "build_log",
          "gate_results",
          "lint_report",
          "typecheck_report",
          "diff_summary",
          "decision_log",
          "trace_link"
        ]
      },
      "uniqueItems": true
    },
    "quality_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "test", "lint", "typecheck"],
      "properties": {
        "build": {
          "type": "boolean"
        },
        "test": {
          "type": "boolean"
        },
        "lint": {
          "type": "boolean"
        },
        "typecheck": {
          "type": "boolean"
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_scope_reduction", "allow_metric_reduction"],
      "properties": {
        "allow_scope_reduction": {
          "type": "boolean"
        },
        "allow_metric_reduction": {
          "type": "boolean"
        },
        "security_policy": {
          "type": "string"
        },
        "performance_budget": {
          "type": "string"
        }
      }
    },
    "change_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "approved_by", "approved_at"],
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "approved_by": {
            "type": "string"
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
