# SDP Repository Mode
# file   = FileCardRepository only (legacy, default)
# beads  = BeadsCardRepository only (target)
# dual   = DualWriteRepository (file primary + beads shadow)
SDP_REPO_MODE=dual

# Optional: beads database path override (auto-discovered if empty)
# SDP_BEADS_DB=/path/to/.beads/beads.db
