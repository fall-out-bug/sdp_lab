# SDP Lab Environment Configuration
# Copy this file to .env and configure values as needed
# Variables marked (required) must be set for core functionality

# =============================================================================
# LLM and API Keys
# =============================================================================

# OpenRouter API key for LLM calls (required for discovery)
# OPENROUTER_API_KEY=sk-or-...

# =============================================================================
# Project Configuration
# =============================================================================

# Project root directory (default: current directory)
# SDP_PROJECT_ROOT=/path/to/project

# Repository mode: "file" (default), "beads", "dual"
# Controls whether SDP uses file-based or beads-backed feature store
SDP_REPO_MODE=dual

# Beads database path override (optional)
# Default: ~/.beads/beads.db
# SDP_BEADS_DB=/path/to/beads.db

# =============================================================================
# Environment Mode
# =============================================================================

# Environment mode (optional)
# SDP_ENVIRONMENT=development

# Production mode flag (optional, default: false)
# PRODUCTION=false

# Enterprise mode flag (optional, default: false)
# ENTERPRISE=false

# =============================================================================
# Agent Configuration
# =============================================================================

# Default agent role (optional)
# Overrides default agent selection logic
# SDP_DEFAULT_AGENT=analyst

# =============================================================================
# Model Configuration
# =============================================================================

# Model for planning tasks (optional)
# SDP_PLAN_MODEL=glm-4.7

# Model for clarification tasks (optional)
# SDP_CLARIFY_MODEL=glm-4.7

# Model for evaluation tasks (optional)
# SDP_EVAL_MODEL=glm-4.7

# Default model for agent operations (optional)
# SDP_MODEL=glm-4.7

# =============================================================================
# Memory and Checkpoints
# =============================================================================

# Enable memory feature (optional, default: false)
# SDP_MEMORY_ENABLED=false

# Memory storage path override (optional)
# Default: XDG_DATA_HOME/sdp/memory or ~/.local/share/sdp/memory
# SDP_MEMORY_PATH=/path/to/memory

# Checkpoint directory (optional)
# Default: .sdp/checkpoints
# SDP_CHECKPOINT_DIR=.sdp/checkpoints

# Runs directory (optional)
# Default: .sdp/runs
# SDP_RUNS_DIR=.sdp/runs

# =============================================================================
# OMO (Orchestration Bridge) Configuration
# =============================================================================

# OMO serve URL for bridge communication (optional)
# OMO_SERVE_URL=http://localhost:8080

# OMO deploy root directory (optional)
# OMO_DEPLOY_ROOT=/path/to/deploy

# =============================================================================
# OpenCode Integration
# =============================================================================

# OpenCode binary path (optional)
# Used for invoking OpenCode agent
# OPENCODE_BIN=/path/to/opencode

# =============================================================================
# Sigstore Configuration
# =============================================================================

# Enable strict Sigstore verification (optional, default: false)
# SDP_SIGSTORE_STRICT_VERIFY=1

# Sigstore identity token (optional)
# SIGSTORE_ID_TOKEN=...

# Cosign private key path (optional)
# COSIGN_KEY=/path/to/key.pem

# =============================================================================
# GitHub Actions Integration
# =============================================================================

# GitHub Actions detection (set automatically by CI)
# GITHUB_ACTIONS=true

# GitHub Actions OIDC token request token (set automatically by CI)
# ACTIONS_ID_TOKEN_REQUEST_TOKEN=...

# GitHub Actions OIDC token request URL (set automatically by CI)
# ACTIONS_ID_TOKEN_REQUEST_URL=...

# =============================================================================
# Beads Transport Configuration
# =============================================================================

# Beads Dolt remote name (optional, default: origin)
# BEADS_DOLT_REMOTE_NAME=origin

# Beads Dolt remote URL (optional)
# BEADS_DOLT_REMOTE_URL=...

# Beads backup remote (optional, default: origin)
# BEADS_BACKUP_REMOTE=origin

# Beads backup branch (optional, default: beads-backup)
# BEADS_BACKUP_BRANCH=beads-backup

# =============================================================================
# Kubernetes Configuration
# =============================================================================

# SDP adapter namespace (optional, default: sdp-adapter)
# SDP_ADAPTER_NS=sdp-adapter

# =============================================================================
# Go Quality Gates
# =============================================================================

# Quality gate mode: container (default) or host
# SDP_GO_QUALITY_MODE=container

# Docker image for containerized quality gates (optional)
# SDP_GO_QUALITY_DOCKER_IMAGE=golang:1.26-bookworm

# =============================================================================
# Development and Testing
# =============================================================================

# E2E test issue ID (for testing)
# E2E_ISSUE_ID=test-issue-123

# Agent registry URL (optional)
# REGISTRY_AGENT_URL=http://localhost:8080

# =============================================================================
# XDG Base Directory (Linux standard)
# =============================================================================

# XDG data home directory (optional)
# Default: ~/.local/share
# XDG_DATA_HOME=/path/to/data
